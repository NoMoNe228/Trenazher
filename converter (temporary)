def generate_sql(filename, table_name, data_list):
    # Внутри функции: 1 уровень отступа (4 пробела)
    sql_path = os.path.join(game_dir, filename)
    
    with open(sql_path, 'w', encoding='utf-8') as f:
        # Внутри контекстного менеджера with: 2 уровень (8 пробелов)
        f.write(f"CREATE TABLE IF NOT EXISTS {table_name} (\n")
        f.write("    id INTEGER PRIMARY KEY AUTOINCREMENT,\n")
        f.write("    text TEXT NOT NULL\n")
        f.write(");\n\n")
        
        for code in data_list:
            # Внутри цикла for: 3 уровень (12 пробелов)
            safe_code = code.replace("'", "''")
            f.write(f"INSERT INTO {table_name} (text) VALUES ('{safe_code}');\n")
            
    # Возвращаемся на 1 уровень (4 пробела)
    print(f"✅ Создан дамп: {filename} ({len(data_list)} элементов) -> Таблица: {table_name}")


